# ----------------------------------------------------------------------------
# Arifhan Yolda — ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyala ve değerleri doldur.
# ----------------------------------------------------------------------------

# Mapbox harita anahtarı (ÜCRETSİZ al: https://account.mapbox.com/access-tokens/)
# Hesap aç -> "Default public token" kopyala. pk.* ile başlar.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.buraya_mapbox_tokeninizi_yapistirin

# (İleride) EmailJS — iletişim formu maili için
# https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
